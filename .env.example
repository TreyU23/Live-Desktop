HOST=127.0.0.1
PORT=4317
# Default model provider for profiles that haven't picked one in Settings: openai or anthropic
ASSISTANT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
OPENAI_REASONING_EFFORT=medium
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=medium
DATA_DIR=../data
WORKSPACE_ROOT=..
